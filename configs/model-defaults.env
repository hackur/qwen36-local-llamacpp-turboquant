# configs/model-defaults.env
#
# Per-model launch defaults. Sourced by scripts/_common.sh::load_model_defaults
# right after the alias is resolved and BEFORE the start scripts read CTX / KV.
#
# Precedence (highest wins):
#   1. Environment / CLI:   `CTX=200000 ./scripts/start-turboquant.sh`
#   2. This file (per-alias case branch below)
#   3. Generic fallback at the bottom
#   4. Script-internal default (e.g. CTX=131072 hard-coded in start-turboquant.sh)
#
# The `: "${VAR:=default}"` idiom only assigns if VAR is unset *or empty*, so any
# value already exported by the user is preserved untouched.
#
# ─────────────────────────────────────────────────────────────────────────────
# When to update this file
# ─────────────────────────────────────────────────────────────────────────────
#
#   • New model alias added to scripts/symlink-models.sh:
#       Add a `case` branch with the model's `n_ctx_train` (read from GGUF
#       metadata: `vendor/llama.cpp-mainline/build/bin/llama-gguf-split --inspect
#       <model.gguf>` or scan the server load log for `n_ctx_train`) and a KV
#       choice — see "Choosing KV" below.
#
#   • Model swap (different default primary/fallback in _common.sh):
#       Update `_common.sh` MODEL_PRIMARY / MODEL_FALLBACK; nothing here changes.
#
#   • TurboQuant fork updated and turbo3 broke for a head-dim or quant format
#     it used to support (e.g. MXFP4): change that alias's KV from `turbo3` to
#     `q8_0` here. Track the upstream fix in TODO so we can revert.
#
#   • Hardware change (more / less RAM): you don't need to edit this file —
#     the start scripts and start-vision.sh memory pre-flight handle headroom.
#     Just override CTX= per-launch if you need a smaller context.
#
# ─────────────────────────────────────────────────────────────────────────────
# Choosing CTX
# ─────────────────────────────────────────────────────────────────────────────
#
# Use the model's `n_ctx_train` as the default ceiling. Going past that needs
# RoPE scaling (see next section) and degrades quality monotonically. The
# practical answer for almost every model:
#
#   CTX = n_ctx_train, unless you're memory-constrained.
#
# 35B-A3B turbo3 KV @ 256K = ~1.3 GiB total (hybrid arch — 10 of 40 layers
# carry attention KV). Dense 27B turbo3 KV @ 256K = ~3.8 GiB. Both fit
# comfortably on 64 GiB.
#
# ─────────────────────────────────────────────────────────────────────────────
# Choosing KV
# ─────────────────────────────────────────────────────────────────────────────
#
#   turbo3   First choice. Best context-per-byte; measured working on Metal.
#            Falls back to q8_0 automatically if the binary doesn't recognize
#            the flag (start-turboquant.sh probes -h).
#
#   q8_0     Safe default. Works on every Metal model; ~2× context vs f16 with
#            negligible quality loss. Use this if turbo3 crashes (`Abort trap: 6`
#            on small head-dim models like `tiny`, or MXFP4 quant like
#            `gpt-oss-20b`).
#
#   f16      Maximum quality, half the context of q8_0. Reserve for the baseline
#            server (port 10500) when you need a known-good control.
#
#   q4_0     Last resort if you're memory-pinned. Recall starts to slip past 32K.
#
# ─────────────────────────────────────────────────────────────────────────────
# RoPE / YaRN — extending context beyond n_ctx_train
# ─────────────────────────────────────────────────────────────────────────────
#
# Qwen 3.6 uses YaRN-style RoPE scaling. To request a context larger than the
# model's training window, set on launch (ALL THREE must agree):
#
#   ROPE_SCALING=yarn
#   ROPE_SCALE=2.0          # 2.0 doubles ctx ; 4.0 quadruples it
#   YARN_ORIG_CTX=262144    # the model's n_ctx_train — DO NOT change to CTX
#
# Quality degrades roughly with the scale factor — coherence holds well at 2×,
# wobbles at 4×, and tends to break at 8×. So this is NOT a default; turn it on
# only when you need it.
#
# Use case we actually care about — "one last shot" compaction
# ────────────────────────────────────────────────────────────
# A long-running session has filled the 256K window and you want to ask the
# model itself to summarize the conversation to disk before discarding it.
# That's a single low-stakes call where some quality drift is fine. Recipe:
#
#   PORT=10599 CTX=524288 \
#     ROPE_SCALING=yarn ROPE_SCALE=2.0 YARN_ORIG_CTX=262144 \
#     MODEL=qwen36-35b KV=turbo3 \
#     ./scripts/start-turboquant.sh &
#
#   curl http://127.0.0.1:10599/v1/chat/completions \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"qwen3.6-turboquant","messages":[<full conv>,
#           {"role":"user","content":"Compact the entire conversation above
#            into a structured JSON note suitable for re-loading later. Include
#            every named entity, decision, and unresolved question."}],
#          "max_tokens":12000,"temperature":0.2,
#          "chat_template_kwargs":{"enable_thinking":false}}' \
#     | tee snapshots/conv-$(date +%Y%m%d-%H%M%S).json
#
# Then kill the transient server. The compacted JSON is small enough to drop
# back into a fresh 256K (un-scaled) session as the system prompt.
#
# Compression note: pipe through `zstd -19` if you want to keep many on disk.
#
# ─────────────────────────────────────────────────────────────────────────────
# Per-alias defaults
# ─────────────────────────────────────────────────────────────────────────────
#
# Each branch sets only what's specific to that model. Anything left unset
# falls through to the generic block at the bottom.
#
# Variables consumed downstream:
#   CTX                — context tokens
#   KV                 — turbo3 / q8_0 / q4_0 / f16
#   ROPE_SCALING       — yarn (unset = no scaling)
#   ROPE_SCALE         — float (1.0 = no scaling; only used if ROPE_SCALING set)
#   YARN_ORIG_CTX      — int (the model's n_ctx_train; only with yarn)

case "${MODEL_ALIAS:-}" in

  # ── Qwen 3.6 35B-A3B Q6_K (MoE 35B/3B-active, FALLBACK in _common.sh) ──
  # n_ctx_train = 262144. Hybrid arch keeps KV tiny: 10 of 40 layers carry
  # attention KV; turbo3 @ 256K measured at ~1.3 GiB.
  qwen36-35b)
    : "${CTX:=262144}"
    : "${KV:=turbo3}"
    ;;

  # ── Qwen 3.6 27B Heretic NEO-CODE Q5_K_M (dense, PRIMARY) ──
  # n_ctx_train = 262144. Dense; KV is bigger than the MoE — see kv-cache-math.md.
  # We default to 131072 for headroom; raise to 262144 explicitly per launch
  # if you really need it (memory pre-flight will warn if too tight).
  qwen36-neo)
    : "${CTX:=131072}"
    : "${KV:=turbo3}"
    ;;

  # ── Qwen 3.6 27B IQ2_XXS (low-mem) ──
  # n_ctx_train = 262144. q8_0 KV is the safe pick at IQ2 quality.
  qwen36-27b)
    : "${CTX:=131072}"
    : "${KV:=q8_0}"
    ;;

  # ── Gemma 4 26B / e4b ──
  # n_ctx_train varies; check at load. turbo3 verified working.
  gemma4-26b|gemma4-e4b)
    : "${CTX:=65536}"
    : "${KV:=turbo3}"
    ;;

  # ── Qwen 3.5 9B / Crow 9B / Nemotron 4B ──
  qwen35-9b|crow-9b)
    : "${CTX:=131072}"
    : "${KV:=turbo3}"
    ;;
  nemotron-4b)
    : "${CTX:=131072}"
    : "${KV:=turbo3}"
    ;;

  # ── Qwen 3.5 0.8B (Q8_0, ~775 MB) ──
  # Tiniest Qwen 3.5/3.6 GGUF on HuggingFace. Primary use: speculative-decoding
  # draft for the larger Qwen3.5/3.6 targets (shared tokenizer family). Also
  # standalone for cold-start / battery-mode / tool-only workloads.
  # n_ctx_train = 32768; small dense — standard turbo3 KV is fine.
  qwen3.5-0.8b)
    : "${CTX:=32768}"
    : "${KV:=turbo3}"
    ;;

  # ── Pinned to q8_0 — turbo3 crashes on these (Abort trap: 6) ──
  # `tiny`: head-dim incompatible with the turbo3 kernel.
  # `gpt-oss-20b`: MXFP4 quant not supported by the turbo3 path.
  # Track upstream TurboQuant fixes — when these land, switch to turbo3 here
  # and remove the entries below.
  tiny)
    # Upstream-blocked (head-dim) — see docs/upstream-tracking.md
    : "${CTX:=32768}"
    : "${KV:=q8_0}"
    ;;
  gpt-oss-20b)
    # Upstream-blocked (MXFP4) — see docs/upstream-tracking.md
    : "${CTX:=65536}"
    : "${KV:=q8_0}"
    ;;

esac

# ── Generic fallback (any alias not listed above) ──
# Conservative defaults; the per-alias branch is the right place for tuning.
: "${CTX:=131072}"
: "${KV:=turbo3}"

# ── RoPE: never on by default. Empty values mean "no scaling". ──
: "${ROPE_SCALING:=}"
: "${ROPE_SCALE:=}"
: "${YARN_ORIG_CTX:=}"
