# Crow 9B (Qwen3.5-9B abliterated, mradermacher Q4_K_S) — lightweight profile.
#
# Sourced by scripts/switch-model.sh BEFORE _common.sh fills defaults, so every
# value here wins. Weights live in LM Studio and are used in place (read-only);
# no symlinks are created in ./models.
#
# To run this profile manually without the switch script:
#   source configs/models/crow-9b.env && ./scripts/start-turboquant.sh

: "${MODEL_FILE:=$HOME/.lmstudio/models/mradermacher/Crow-9B-Opus-4.6-Distill-Heretic_Qwen3.5-GGUF/Crow-9B-Opus-4.6-Distill-Heretic_Qwen3.5.Q4_K_S.gguf}"
: "${MMPROJ_FILE:=$HOME/.lmstudio/models/mradermacher/Crow-9B-Opus-4.6-Distill-Heretic_Qwen3.5-GGUF/Crow-9B-Opus-4.6-Distill-Heretic_Qwen3.5.mmproj-f16.gguf}"

# Distinct alias so opencode can target it as its own model id and status
# output tells the profiles apart. The launcher passes --alias "$MODEL_NAME".
# Change only if the model identity changes.
: "${MODEL_NAME:=crow-9b-local}"

# Smaller context: 5 GiB of weights leaves the vast majority of the 64 GiB
# unified memory to KV cache, so 32K is plenty for interactive use and keeps
# prompt processing fast. Bump to 65536 if longer sessions are needed.
: "${CTX:=32768}"

# MTP speculative decoding is Qwen3.8-specific (draft-mtp weights live in the
# 27B GGUF). The 9B has none; running with MTP=1 would fail the flag check or
# silently degrade, so disable it explicitly.
: "${MTP:=0}"

# KV quantization: q8_0 K / turbo3 V still applies (engine-side) and is safe
# at 9B scale; left at runtime.env defaults.
