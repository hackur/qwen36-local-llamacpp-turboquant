<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>           <string>com.local.qwen3-8.turboquant</string>
  <key>ProgramArguments</key>
  <array>
    <!-- `foreground` makes start-turboquant.sh exec llama-server as its direct
         child (no pipeline/tee), so this job's PID is the server itself and
         launchd owns its full lifecycle. -->
    <string>__REPO__/scripts/start-turboquant.sh</string>
    <string>foreground</string>
  </array>
  <key>RunAtLoad</key>       <true/>
  <key>KeepAlive</key>       <true/>
  <key>StandardOutPath</key> <string>__REPO__/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/launchd.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TURBO_LAYER_ADAPTIVE</key><string>1</string>
  </dict>
</dict>
</plist>

<!-- __REPO__ is replaced by scripts/service.sh register. See docs/service.md. -->
