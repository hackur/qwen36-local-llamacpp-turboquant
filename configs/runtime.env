# Qwen3.8 runtime defaults.
#
# This is the single source of truth for the only supported model. Launchers
# use environment values first, then fill unset values from this file. That
# keeps routine overrides temporary without allowing model-family drift back
# into scripts and documentation.

: "${MODEL_ALIAS:=qwen38-27b}"
: "${MODEL_NAME:=qwen3.8-local}"
: "${PORT:=10501}"
: "${CTX:=262144}"

# Qwen3.8-27B has a 6:1 GQA ratio. TurboQuant automatically rewrites a
# requested turbo3/turbo3 cache to q8_0/turbo3 to protect K-cache quality.
# Request the effective pair explicitly so logs, dry-runs, and benchmarks all
# describe the configuration that actually executes.
: "${KV_K:=q8_0}"
: "${KV_V:=turbo3}"

# Qwen's official model card recommends these values for thinking mode.
# Non-thinking clients should override sampling per request as documented.
: "${TEMP:=1.0}"
: "${TOP_P:=0.95}"
: "${TOP_K:=20}"
: "${MIN_P:=0.0}"
: "${PRESENCE_PENALTY:=0.0}"
: "${REPEAT_PENALTY:=1.0}"

# Full local feature profile. The current TurboQuant fork validates adaptive
# and chained MTP on Metal. Depth starts at 3 for prose and can climb to 8 for
# predictable code. The Qwen3.8 projector is loaded in the same process, so
# text, image, and agent sessions share one model and one endpoint.
: "${MTP:=1}"
: "${MTP_TYPE:=draft-mtp-adaptive}"
: "${MTP_MIN:=3}"
: "${MTP_MAX:=8}"
: "${MTP_CHAIN:=8}"
: "${MTP_P_MIN:=0.0}"
: "${IMAGE_MIN_TOKENS:=1024}"
: "${METRICS:=1}"
: "${AGENT:=1}"
: "${REASONING_PRESERVE:=1}"

# Optional external MCP server config in Cursor-compatible JSON format.
# Built-in tools and the WebUI MCP proxy come from --agent even when unset.
: "${MCP_CONFIG:=}"

# Native context is the default. YaRN is an explicit escape hatch for inputs
# beyond 262,144 tokens; Qwen recommends matching the scale to real workload.
: "${ROPE_SCALING:=}"
: "${ROPE_SCALE:=}"
: "${YARN_ORIG_CTX:=262144}"
